# Yerel geliştirme için örnek anahtarlar; gerçek sır eklemeyin.
# Değerler boş bırakılır; gerçek değerler yalnız .env.local'de tutulur.
DATABASE_URL=
# xAPI uç noktası; biçim: http://localhost:8080/xapi
LRS_ENDPOINT=
# --- Geliştirme altyapısı: infra/docker-compose.dev.yml ---
# Postgres: EGEMED platformu geliştirme veritabanı (ifade tutmaz; bkz. ADR-004).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# SQL LRS: geliştirme LRS'si; kurum LRS'sinin yerini tutar.
LRS_PORT=
# xAPI Basic auth çifti ve yönetici hesabı (yalnız geliştirme).
LRS_API_KEY=
LRS_API_SECRET=
LRS_ADMIN_USER=
LRS_ADMIN_PASS=

# --- xAPI profili (packages/xapi-profile) ---
XAPI_ACTIVITY_BASE_IRI=
XAPI_ACTOR_HOMEPAGE=

# --- apps/api (T62) ---
# API dinleme portu; boşsa 3000 kullanılır.
PORT=
# Çalışma ortamı: development | test | production.
NODE_ENV=
# Geliştirme sağlayıcısı (E3 §a); yalnız üretim dışı ortamda true olabilir.
AUTH_DEV_ENABLED=

# --- apps/api SSO adaptörü (T64; protokol kararı §i bekleniyor) ---
# Sağlayıcı kimliği: none | oidc | saml | cas; boşsa /auth/sso/* uçları 404 döner.
SSO_PROVIDER=
# state/nonce çerezini imzalayan HMAC anahtarı; en az 32 karakter (yalnız yerel .env'de).
SSO_STATE_SECRET=
