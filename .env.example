# Yerel geliştirme için örnek anahtarlar; gerçek sır eklemeyin.
# Değerler boş bırakılır; gerçek değerler yalnız .env.local'de tutulur.
DATABASE_URL=
# xAPI uç noktası; biçim: http://localhost:8080/xapi
LRS_ENDPOINT=
# --- Geliştirme altyapısı: infra/docker-compose.dev.yml ---
# Postgres: CLIX geliştirme veritabanı (ifade tutmaz; bkz. ADR-004).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# SQL LRS: geliştirme LRS'si; kurum LRS'sinin yerini tutar.
LRS_PORT=
# xAPI Basic auth çifti ve yönetici hesabı (yalnız geliştirme).
LRS_API_KEY=
LRS_API_SECRET=
LRS_ADMIN_USER=
LRS_ADMIN_PASS=

# --- xAPI profili (packages/xapi-profile) ---
XAPI_ACTIVITY_BASE_IRI=
XAPI_ACTOR_HOMEPAGE=
