{
  "name": "egemed-clix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "infra:up": "docker compose -p egemed-local --env-file .env.local -f infra/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -p egemed-local --env-file .env.local -f infra/docker-compose.dev.yml down --remove-orphans",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
