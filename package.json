{
  "name": "egemed-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "e2e:mobile": "playwright test",
    "e2e:api": "E2E_REQUIRE_API=1 playwright test --project=api-dev",
    "infra:up": "docker compose -p egemed-local --env-file .env.local -f infra/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -p egemed-local --env-file .env.local -f infra/docker-compose.dev.yml down --remove-orphans",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
