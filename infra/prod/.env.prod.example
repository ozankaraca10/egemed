# EGEMED üretim ortam örneği (T32) — değerler kasıtlı olarak boştur.
# Gerçek değerler yalnız yerel infra/prod/.env.prod dosyasına yazılır; .env.prod
# repoda izlenmez (bkz. .gitignore). Compose --env-file ile bu dosyayı okur:
#   docker compose --env-file infra/prod/.env.prod -f infra/prod/docker-compose.prod.yml up -d --wait

# --- Postgres (docker-compose.prod.yml → postgres) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- API (docker-compose.prod.yml → api) ---
# DSN sır içerir; biçim: postgres://KULLANICI:@postgres:5432/VERITABANI —
# PAROLA'yı KULLANICI'dan sonraki iki nokta ile ana makine arasına yazın ve
# özel karakterleri yüzde kodlayın (percent-encoding). Ana makine adı compose
# ağındaki servis adıdır (postgres).
DATABASE_URL=

# SSO sağlayıcı: none | oidc | saml | cas. Boşsa none olur ve
# /auth/sso/* uçları 404 döner (apps/api/src/env.ts sözleşmesi).
SSO_PROVIDER=

# SSO_PROVIDER none dışında seçildiğinde zorunlu: state/nonce çerezini imzalayan
# HMAC anahtarı; en az 32 karakter. Sırdır; yalnız bu dosyada tutulur.
SSO_STATE_SECRET=
