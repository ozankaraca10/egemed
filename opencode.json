{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "sims/*/src/data/*.json": "deny",
      "sims/*/public/assets/**": "deny",
      "**/dist/**": "deny",
      "**/*.lock": "deny",
      "reports/**": "deny"
    }
  },
  "mcp": {
    "agtx": {
      "type": "local",
      "command": [
        "agtx",
        "mcp-serve"
      ],
      "enabled": true
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "max"
    }
  }
}
